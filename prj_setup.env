#! /bin/csh
# source /App/env/digital.cshrc
set prompt="%/>>"

###########################################
### EDA TOOLS
if ( -d $HOME/.openclaw/bin ) then
    set path=($HOME/.openclaw/bin $path)
endif

if ( -d $HOME/.local/eda/bin ) then
    set path=($HOME/.local/eda/bin $path)
endif

# Python
# Prefer the locally installed modern Python on regression servers.
if ( -d $HOME/.local/python-3.9.19/bin ) then
    set path=($HOME/.local/python-3.9.19/bin $path)
    setenv PYTHON3 $HOME/.local/python-3.9.19/bin/python3.9
endif

#coreConsultant
##TODO setenv DESIGNWARE_HOME /prj/work_area/atom/dw
##TODO set path=($path /prj/work_area/atom/dw/bin)
if ( -d /eda_tools/synopsys/coretools/S-2021.09/bin ) then
    set path=($path /eda_tools/synopsys/coretools/S-2021.09/bin)
else if ( -d /App/synopsys/coretools/S-2021.09-SP4-1/bin ) then
    set path=($path /App/synopsys/coretools/S-2021.09-SP4-1/bin)
endif

# nLint
##TODO set path = ( $path /eda_tools/nlint_vK-2015.09/bin)

# verdi
if ( -d /eda_tools/synopsys/verdi/S-2021.09/bin ) then
    set path =($path /eda_tools/synopsys/verdi/S-2021.09/bin)
    setenv VERDI_HOME /eda_tools/synopsys/verdi/S-2021.09
else if ( -d /App/synopsys/verdi/S-2021.09-SP2/bin ) then
    set path =($path /App/synopsys/verdi/S-2021.09-SP2/bin)
    setenv VERDI_HOME /App/synopsys/verdi/S-2021.09-SP2
endif

# VCS
if ( -d /eda_tools/synopsys/vcs/S-2021.09-SP2/bin ) then
    set path=($path /eda_tools/synopsys/vcs/S-2021.09-SP2/bin)
    setenv VCS_HOME /eda_tools/synopsys/vcs/S-2021.09-SP2
else if ( -d /App/synopsys/vcs/S-2021.09-SP2/bin ) then
    set path=($path /App/synopsys/vcs/S-2021.09-SP2/bin)
    setenv VCS_HOME /App/synopsys/vcs/S-2021.09-SP2
endif

# VERA
##TODO setenv VERA_HOME /eda_tools/vera_vI-2014.03-2.auth/vera_vI-2014.03-2_amd64
##TODO set path = ( $path $VERA_HOME/bin )

if ( -f /home/eda/license/synopsys.dat ) then
    setenv LM_LICENSE_FILE /home/eda/license/synopsys.dat
else if ( ! $?LM_LICENSE_FILE ) then
    setenv LM_LICENSE_FILE 27000@localhost.localdomain
endif

echo "##################################################################"
echo "################  Server Setting DONE          ###################"
echo "##################################################################"

##########################################
### PROJECT SETUP
setenv PROJECT_HOME `pwd`
setenv HDL_PATH $PROJECT_HOME/src
setenv VER_PATH $PROJECT_HOME/vrf
setenv SIM_PATH $VER_PATH/sim
