<mxfile host="app.diagrams.net" modified="2026-05-09T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="enc-otf-to-tile-flow" name="ENC OTF_TO_TILE 流程">
    <mxGraphModel dx="1800" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="ENC OTF_TO_TILE 数据流程图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=34;fontStyle=1;fontColor=#0f172a;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="620" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="对应 RTL：ubwc_enc_otf_to_tile / ubwc_enc_otf_data_packer / ubwc_enc_line_to_tile" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="lane0" value="i_otf_clk 域：输入采样与格式打包" style="swimlane;html=1;rounded=1;startSize=44;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="500" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="lane1" value="clk 域：line_to_tile 与 ping-pong SRAM" style="swimlane;html=1;rounded=1;startSize=44;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="615" y="125" width="570" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="输出队列：tile data / CI / coord" style="swimlane;html=1;rounded=1;startSize=44;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1250" y="125" width="500" height="850" as="geometry"/>
        </mxCell>

        <mxCell id="otf_in" value="&lt;b&gt;OTF 输入&lt;/b&gt;&lt;br&gt;i_otf_vsync / hsync / de&lt;br&gt;i_otf_data[127:0] + fcnt/lcnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="95" y="190" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="err_chk" value="&lt;b&gt;基础检查与 sticky error&lt;/b&gt;&lt;br&gt;bad line / bad frame / fifo overflow&lt;br&gt;err_clear 清除 sticky 状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="95" y="345" width="360" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="packer" value="&lt;b&gt;ubwc_enc_otf_data_packer&lt;/b&gt;&lt;br&gt;锁存 fcnt/lcnt，形成 sideband&lt;br&gt;按 format 拆成 RGBA/Y 与 UV&lt;br&gt;{fcnt,lcnt,vsync,hsync,tlast,keep,data}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="95" y="508" width="360" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="fifo_a" value="&lt;b&gt;FIFO A&lt;/b&gt;&lt;br&gt;RGBA / Y&lt;br&gt;fifo_a_vld/rdy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="95" y="700" width="165" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="fifo_b" value="&lt;b&gt;FIFO B&lt;/b&gt;&lt;br&gt;UV&lt;br&gt;YUV420 使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="290" y="700" width="165" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="skid" value="&lt;b&gt;skid + decode stage&lt;/b&gt;&lt;br&gt;缓存 FIFO A/B 输出，切断 ready 组合环&lt;br&gt;解析 fcnt / group_id / plane / tlast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="690" y="190" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="arb" value="&lt;b&gt;写侧仲裁与 bank 归属&lt;/b&gt;&lt;br&gt;wr_bank_sel 选择当前写 bank&lt;br&gt;A/B 通道按 group 和 done 状态接收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="690" y="365" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="bank0" value="&lt;b&gt;SRAM bank0&lt;/b&gt;&lt;br&gt;写：line group&lt;br&gt;读：tile order&lt;br&gt;ready_for_read 到 release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="665" y="540" width="205" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="bank1" value="&lt;b&gt;SRAM bank1&lt;/b&gt;&lt;br&gt;写：line group&lt;br&gt;读：tile order&lt;br&gt;与 bank0 乒乓切换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="930" y="540" width="205" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="reader" value="&lt;b&gt;读侧 tile 扫描&lt;/b&gt;&lt;br&gt;RD_IDLE → RD_ACT → RD_FIN&lt;br&gt;输出 128b tile beat + plane/x/y/fcnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="690" y="730" width="420" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="data_out" value="&lt;b&gt;data pack FIFO&lt;/b&gt;&lt;br&gt;两个 128b beat 合成 256b tile&lt;br&gt;输出 o_tile_data/keep/last/fcnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1315" y="185" width="360" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="ci_fifo" value="&lt;b&gt;CI FIFO&lt;/b&gt;&lt;br&gt;tile_x / tile_y / format / fcnt&lt;br&gt;forced_pcm 标记边界 partial tile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1315" y="350" width="360" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="coord_fifo" value="&lt;b&gt;coord FIFO&lt;/b&gt;&lt;br&gt;跟随 CI 出口保存 x/y/format/fcnt&lt;br&gt;o_co_sb = fcnt[0]&lt;br&gt;最后 tile 触发 addr_cfg_done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1315" y="510" width="360" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="stat" value="&lt;b&gt;统计与中断&lt;/b&gt;&lt;br&gt;otf_de_count / line_count 按 fcnt[0]&lt;br&gt;倒数第 4 行 correct_irq&lt;br&gt;slot0/slot1 独立计数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1315" y="710" width="360" height="126" as="geometry"/>
        </mxCell>

        <mxCell id="e0" edge="1" parent="1" source="otf_in" target="err_chk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e1" edge="1" parent="1" source="err_chk" target="packer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e2" edge="1" parent="1" source="packer" target="fifo_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e3" edge="1" parent="1" source="packer" target="fifo_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e4" edge="1" parent="1" source="fifo_a" target="skid" value="A/B packed stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=13;"/>
        <mxCell id="e5" edge="1" parent="1" source="skid" target="arb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e6" edge="1" parent="1" source="arb" target="bank0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e7" edge="1" parent="1" source="arb" target="bank1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e8" edge="1" parent="1" source="bank0" target="reader" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e9" edge="1" parent="1" source="bank1" target="reader" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e10" edge="1" parent="1" source="reader" target="data_out" value="tile beat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=13;"/>
        <mxCell id="e11" edge="1" parent="1" source="reader" target="ci_fifo" value="tile command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=13;"/>
        <mxCell id="e12" edge="1" parent="1" source="ci_fifo" target="coord_fifo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#64748b;"/>
        <mxCell id="e13" edge="1" parent="1" source="coord_fifo" target="stat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#64748b;"/>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="enc-pingpong-sram" name="ENC ping-pong SRAM 调度">
    <mxGraphModel dx="1800" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title2" value="ENC ping-pong SRAM 数据调度图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=34;fontStyle=1;fontColor=#0f172a;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="720" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sub2" value="bank0/bank1 在写行组与读 tile 之间交替复用；fcnt 随 group 锁存并一路传递到 tile/CI/coord" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="980" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="b0_label" value="bank0" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#111827;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="230" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b1_label" value="bank1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#111827;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="100" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="b0w0" value="&lt;b&gt;写 Group N&lt;/b&gt;&lt;br&gt;A/Y 或 RGBA 行组写入&lt;br&gt;等待 A done / B done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="250" y="220" width="340" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b0r0" value="&lt;b&gt;读 Group N&lt;/b&gt;&lt;br&gt;RD_ACT 按 tile 顺序扫描&lt;br&gt;输出到 resp_fifo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="220" width="340" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b0idle" value="&lt;b&gt;释放 / 空闲&lt;/b&gt;&lt;br&gt;RD_FIN 且 FIFO 清空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="990" y="220" width="300" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b0w2" value="&lt;b&gt;写 Group N+2&lt;/b&gt;&lt;br&gt;wr_bank_sel 切回 bank0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1320" y="220" width="320" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="b1idle0" value="&lt;b&gt;空闲&lt;/b&gt;&lt;br&gt;等待 bank0 ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="250" y="370" width="300" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b1w1" value="&lt;b&gt;写 Group N+1&lt;/b&gt;&lt;br&gt;与 bank0 读并行&lt;br&gt;wr_bank_switch 后写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="370" width="340" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b1r1" value="&lt;b&gt;读 Group N+1&lt;/b&gt;&lt;br&gt;bank1_safe_for_read 后启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="990" y="370" width="340" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="b1hold" value="&lt;b&gt;保持 / 等待读完&lt;/b&gt;&lt;br&gt;直到 bank1_release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1360" y="370" width="280" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="layout" value="&lt;b&gt;单 bank 内部布局&lt;/b&gt;&lt;br&gt;A 通道：RGBA/Y，从 base 0 写入&lt;br&gt;B 通道：UV，从 sram_uv_base 写入&lt;br&gt;YUV420 10bit 使用 y_lower_base / uv_base 分区&lt;br&gt;读侧：tile_x → word_in_tile → plane/subrow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="130" y="620" width="700" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;切换与释放条件&lt;/b&gt;&lt;br&gt;1. ready_for_read：A done，并且无 B 或 B done&lt;br&gt;2. wr_bank_switch：当前写 bank ready，另一个 bank 可写&lt;br&gt;3. rd_start_bank*：bank safe_for_read 后读侧启动&lt;br&gt;4. bank*_release：RD_FIN 且 resp_fifo/read_meta_fifo 清空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="970" y="620" width="700" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="p0" edge="1" parent="1" source="b0w0" target="b0r0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="p1" edge="1" parent="1" source="b0r0" target="b0idle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="p2" edge="1" parent="1" source="b0idle" target="b0w2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="p3" edge="1" parent="1" source="b1idle0" target="b1w1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="p4" edge="1" parent="1" source="b1w1" target="b1r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="p5" edge="1" parent="1" source="b1r1" target="b1hold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="x0" edge="1" parent="1" source="b0w0" target="b1w1" value="bank0 ready 后切写 bank1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#64748b;fontSize=13;"/>
        <mxCell id="x1" edge="1" parent="1" source="b1r1" target="b0w2" value="bank0 release 后复用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#64748b;fontSize=13;"/>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
