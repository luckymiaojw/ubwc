  <diagram id="dec-tile-to-otf-flow" name="DEC TILE_TO_OTF">
    <mxGraphModel dx="1900" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DEC TILE_TO_OTF 数据流程图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=34;fontStyle=1;fontColor=#0f172a;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="680" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="ubwc_dec_tile_to_otf / tile_to_line_writer / sram_read_fetcher / otf_driver" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lane0" value="i_axi_clk / clk_sram 域：VIVO 输出写入行缓存" style="swimlane;html=1;rounded=1;startSize=44;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="560" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane1" value="i_axi_clk / clk_sram 域：SRAM 读出与 CDC 入队" style="swimlane;html=1;rounded=1;startSize=44;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="665" y="125" width="560" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="lane2" value="i_otf_clk 域：OTF timing 与像素输出" style="swimlane;html=1;rounded=1;startSize=44;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1280" y="125" width="560" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="vivo_stream" value="&lt;b&gt;来自 VIVO 的 tile stream&lt;/b&gt;&lt;br&gt;format / tile_x / tile_y / fcnt&lt;br&gt;rvo_valid / rvo_data[255:0] / rvo_last" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="105" y="205" width="400" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="writer" value="&lt;b&gt;tile_to_line_writer&lt;/b&gt;&lt;br&gt;header FIFO + data FIFO 对齐 tile&lt;br&gt;按格式映射到 output line slot&lt;br&gt;写 SRAM A/B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="105" y="370" width="400" height="126" as="geometry"/>
        </mxCell>
        <mxCell id="sram_a" value="&lt;b&gt;OTF SRAM A&lt;/b&gt;&lt;br&gt;line buffer&lt;br&gt;sram_a_wen/waddr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="105" y="555" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="sram_b" value="&lt;b&gt;OTF SRAM B&lt;/b&gt;&lt;br&gt;另一组 line buffer&lt;br&gt;sram_b_wen/waddr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="325" y="555" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pending" value="&lt;b&gt;pending_a / pending_b&lt;/b&gt;&lt;br&gt;writer_vld 标记完整 buffer&lt;br&gt;fetcher_done 后清 pending&lt;br&gt;fetcher_bank_sel 选择待读 bank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="105" y="735" width="400" height="126" as="geometry"/>
        </mxCell>

        <mxCell id="fetcher" value="&lt;b&gt;sram_read_fetcher&lt;/b&gt;&lt;br&gt;从 pending bank 读取 line data&lt;br&gt;ST_IDLE → ISSUE_FIRST → ISSUE_SECOND → PUSH&lt;br&gt;输出 256b compact data + fcnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="745" y="235" width="400" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="read_a" value="&lt;b&gt;读 SRAM A&lt;/b&gt;&lt;br&gt;target_bank=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="745" y="435" width="185" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="read_b" value="&lt;b&gt;读 SRAM B&lt;/b&gt;&lt;br&gt;target_bank=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="435" width="185" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="cdc0" value="&lt;b&gt;CDC FIFO0&lt;/b&gt;&lt;br&gt;clk_sram 写，clk_otf 读&lt;br&gt;承载 256b compact line/pixel group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="745" y="635" width="400" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="cdc1" value="&lt;b&gt;CDC FIFO1 保留&lt;/b&gt;&lt;br&gt;当前 RTL wr_en=1'b0&lt;br&gt;otf_driver fifo_sel=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="745" y="815" width="400" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="cdc_start" value="&lt;b&gt;frame_start / fcnt CDC&lt;/b&gt;&lt;br&gt;frame_start_toggle 同步到 OTF 域&lt;br&gt;frame_fcnt 双拍同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1355" y="205" width="400" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="driver" value="&lt;b&gt;otf_driver timing FSM&lt;/b&gt;&lt;br&gt;根据 H/V timing 生成 vsync/hsync/de&lt;br&gt;active window 内从 FIFO0 取 compact_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1355" y="370" width="400" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="unpack" value="&lt;b&gt;格式解包与输出寄存&lt;/b&gt;&lt;br&gt;RGBA：256b 分两拍输出 128b&lt;br&gt;NV12/P010：按奇偶行插入 UV&lt;br&gt;输出边界打一拍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1355" y="585" width="400" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="irq" value="&lt;b&gt;done / correct irq / counters&lt;/b&gt;&lt;br&gt;frame done / correct irq&lt;br&gt;line_count / de_count 回同步到 axi 域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1355" y="790" width="400" height="126" as="geometry"/>
        </mxCell>

        <mxCell id="e0" edge="1" parent="1" source="vivo_stream" target="writer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e1" edge="1" parent="1" source="writer" target="sram_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e2" edge="1" parent="1" source="writer" target="sram_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e3" edge="1" parent="1" source="sram_a" target="pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e4" edge="1" parent="1" source="pending" target="fetcher" value="pending bank request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=13;"/>
        <mxCell id="e5" edge="1" parent="1" source="fetcher" target="read_a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e6" edge="1" parent="1" source="fetcher" target="read_b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e7" edge="1" parent="1" source="read_a" target="cdc0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e8" edge="1" parent="1" source="cdc0" target="driver" value="compact data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;fontSize=13;"/>
        <mxCell id="e9" edge="1" parent="1" source="cdc_start" target="driver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e10" edge="1" parent="1" source="driver" target="unpack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
        <mxCell id="e11" edge="1" parent="1" source="unpack" target="irq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#334155;"/>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="dec-overall-dataflow" name="DEC 整体数据流">
