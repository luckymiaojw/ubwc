        <mxCell id="vivo" value="&lt;b&gt;ubwc_dec_vivo_top&lt;/b&gt;&lt;br&gt;解码 UBWC tile payload&lt;br&gt;输出 rvo_valid/rvo_data/rvo_last" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
