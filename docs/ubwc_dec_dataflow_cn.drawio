        </mxCell>
        <mxCell id="otf" value="&lt;b&gt;OTF output interface&lt;/b&gt;&lt;br&gt;o_otf_vsync / hsync / de&lt;br&gt;o_otf_data[127:0] / fcnt / lcnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1350" y="825" width="390" height="126" as="geometry"/>
