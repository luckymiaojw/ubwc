        <mxCell id="enc_power" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.8;fontSize=16;fontColor=#374151;" value="&lt;b&gt;1. 上电检查&lt;/b&gt;&lt;br&gt;READ VERSION / DATE，确认硬件版本" vertex="1">
